# Copy to .env and fill in. Do not commit .env.

# FRED (US Federal Reserve Economic Data) — free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Override default request timeout in seconds
HTTP_TIMEOUT=20

# User-Agent for scraping (be a good citizen)
HTTP_USER_AGENT=ManulifeAnalyzer/0.1 (contact: your-email@example.com)
