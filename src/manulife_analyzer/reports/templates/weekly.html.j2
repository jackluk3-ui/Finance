{% extends "base.html.j2" %}

{% block content %}
<h2>Macro snapshot</h2>
<div class="commentary">
  <ul>
    {% for line in macro.commentary %}<li>{{ line }}</li>{% endfor %}
    {% if not macro.commentary %}<li>No macro data available yet — run <code>manulife fetch</code> with a FRED API key.</li>{% endif %}
  </ul>
</div>

{% if macro_charts %}
  {% for chart in macro_charts %}
    <img class="chart" src="{{ chart }}" alt="macro chart">
  {% endfor %}
{% endif %}

<h2>Fund performance — last {{ lookback_days }} days</h2>
{% if return_chart %}
  <img class="chart" src="{{ return_chart }}" alt="fund returns">
{% endif %}

<table>
  <thead>
    <tr>
      <th>Fund</th>
      <th>Category</th>
      <th class="num">Return ({{ lookback_days }}D)</th>
      <th class="num">Vol (ann.)</th>
      <th class="num">Sharpe 90D</th>
      <th class="num">Max DD 1Y</th>
    </tr>
  </thead>
  <tbody>
    {% for row in fund_table %}
    <tr>
      <td>{{ row.name }}</td>
      <td><span class="badge">{{ row.category }}</span><span class="badge">{{ row.region }}</span></td>
      <td class="num {{ 'pos' if row.return_pct and row.return_pct >= 0 else 'neg' }}">
        {{ "{:+.2f}%".format(row.return_pct * 100) if row.return_pct is not none else "—" }}
      </td>
      <td class="num">{{ "{:.1f}%".format(row.vol * 100) if row.vol is not none else "—" }}</td>
      <td class="num">{{ "{:.2f}".format(row.sharpe) if row.sharpe is not none else "—" }}</td>
      <td class="num neg">{{ "{:.1f}%".format(row.max_dd * 100) if row.max_dd is not none else "—" }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h2>Screening candidates — short-term lens</h2>
<p>Funds ranked highest by a blended momentum + risk-adjusted score over the
trailing month. <em>Candidates for further review</em> — confirm suitability
against the client's mandate before acting.</p>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Fund</th>
      <th class="num">Score</th>
      <th>Why it shows up</th>
    </tr>
  </thead>
  <tbody>
    {% for r in candidates %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ r.name }}</td>
      <td class="num">{{ "{:.2f}".format(r.score) }}</td>
      <td>{{ r.rationale }}</td>
    </tr>
    {% endfor %}
    {% if not candidates %}
    <tr><td colspan="4">No candidates produced — need more historical data.</td></tr>
    {% endif %}
  </tbody>
</table>
{% endblock %}
