{% extends "base.html.j2" %}

{% block content %}
<h2>本週重點</h2>
<div class="commentary">
  <ul>
    {% for line in macro.commentary %}<li>{{ line }}</li>{% endfor %}
    {% if not macro.commentary %}<li>暫無宏觀數據 — 請先設定 FRED_API_KEY 並執行 <code>manulife fetch</code>。</li>{% endif %}
  </ul>
</div>
{% if volatility_alert %}
<div class="alert"><strong>波動提示：</strong>{{ volatility_alert }}</div>
{% endif %}

<h2>板塊熱度（基準 ETF）</h2>
<p class="muted">
  以下板塊基準（VanEck/iShares/SPDR 等 ETF）僅作市場熱度參考。
  「⚠️」標示係指該板塊強勢但客戶基金池冇相關曝險，可考慮加入主題基金。
</p>
<table>
  <thead>
    <tr>
      <th>板塊</th>
      <th class="num">30日</th>
      <th class="num">90日</th>
      <th class="num">波動率</th>
      <th>客戶曝險</th>
    </tr>
  </thead>
  <tbody>
    {% for t in themes %}
    <tr>
      <td><strong>{{ t.label_zh }}</strong>
        <span class="muted">({{ t.tickers | join(', ') }})</span></td>
      <td class="num {{ 'pos' if t.return_30d and t.return_30d >= 0 else 'neg' }}">
        {{ "{:+.1f}%".format(t.return_30d * 100) if t.return_30d is not none else "—" }}
      </td>
      <td class="num {{ 'pos' if t.return_90d and t.return_90d >= 0 else 'neg' }}">
        {{ "{:+.1f}%".format(t.return_90d * 100) if t.return_90d is not none else "—" }}
      </td>
      <td class="num">{{ "{:.1f}%".format(t.vol_30d * 100) if t.vol_30d is not none else "—" }}</td>
      <td>
        {% if t.has_exposure %}
          ✅ {{ t.exposed_funds | join('、') }}
        {% elif t.return_30d and t.return_30d > 0.05 %}
          ⚠️ 冇曝險
        {% else %}
          <span class="muted">冇曝險</span>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h2>宏觀概覽</h2>
{% if macro_charts %}
  {% for chart in macro_charts %}
    <img class="chart" src="{{ chart }}" alt="宏觀數據圖表">
  {% endfor %}
{% endif %}

<h2>基金表現 — 過去 {{ lookback_days }} 日</h2>
{% if return_chart %}
  <img class="chart" src="{{ return_chart }}" alt="基金回報圖">
{% endif %}

<table>
  <thead>
    <tr>
      <th>基金</th>
      <th>類別</th>
      <th class="num">{{ lookback_days }}日回報</th>
      <th class="num">年化波動</th>
      <th class="num">夏普 90D</th>
      <th class="num">1年最大回撤</th>
    </tr>
  </thead>
  <tbody>
    {% for row in fund_table %}
    <tr>
      <td>{{ row.name_zh or row.name }}</td>
      <td>
        <span class="badge">{{ row.category }}</span>
        <span class="badge">{{ row.region }}</span>
        {% if row.theme %}<span class="badge badge-theme">{{ row.theme }}</span>{% endif %}
      </td>
      <td class="num {{ 'pos' if row.return_pct and row.return_pct >= 0 else 'neg' }}">
        {{ "{:+.2f}%".format(row.return_pct * 100) if row.return_pct is not none else "—" }}
      </td>
      <td class="num">{{ "{:.1f}%".format(row.vol * 100) if row.vol is not none else "—" }}</td>
      <td class="num">{{ "{:.2f}".format(row.sharpe) if row.sharpe is not none else "—" }}</td>
      <td class="num neg">{{ "{:.1f}%".format(row.max_dd * 100) if row.max_dd is not none else "—" }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h2>四個時間框架嘅組合建議</h2>
<p class="muted">
  以下組合根據基金近期表現自動生成，每個時間框架用唔同打分公式
  （1個月睇動量、1年睇夏普、長線睇分散）。<strong>屬候選清單，最終建議由顧問簽字。</strong>
</p>
{% for key in portfolio_order if key in portfolios %}
  {% set portfolio = portfolios[key] %}
  {% include "_portfolio_section.html.j2" %}
{% endfor %}
{% endblock %}
